{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "fs-editor",
  "version": "0.1.0",
  "description": "C/C++ dependencies of FS Editor (media decoding and subtitle rendering)",
  "license": "BSD-3-Clause",
  "dependencies": [
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": ["avcodec", "avformat", "swscale", "swresample", "dav1d", "zlib", "bzip2"]
    },
    "xxhash",
    "libass",
    "bestsource"
  ]
}
