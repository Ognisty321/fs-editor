{
  "name": "bestsource",
  "version": "22",
  "description": "Frame/sample accurate audio and video source library built on FFmpeg (library only, no VapourSynth/AviSynth plugin, no GPU decoding)",
  "homepage": "https://github.com/vapoursynth/bestsource",
  "license": "MIT",
  "supports": "!uwp",
  "dependencies": [
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": ["avcodec", "avformat"]
    },
    "xxhash",
    { "name": "vcpkg-cmake", "host": true },
    { "name": "vcpkg-cmake-config", "host": true }
  ]
}
